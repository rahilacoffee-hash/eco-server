generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
}

enum ContactStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  COMPLETED
}

model User {
  id              String       @id @default(cuid())
  name            String
  email           String       @unique
  passwordHash    String
  role            UserRole     @default(ADMIN)
  status          UserStatus   @default(ACTIVE)
  emailVerifiedAt DateTime?

  refreshSessions  RefreshSession[]
  verificationTokens EmailVerificationToken[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String

  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model RefreshSession {
  id         String   @id @default(cuid())
  userId     String

  tokenHash  String   @unique
  familyId   String
  jti        String   @unique

  expiresAt  DateTime
  revokedAt  DateTime?

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([familyId])
}
model Project {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  brief           String
  description     String?
  category        String
  location        String?
  completionYear  Int?
  status          ProjectStatus @default(DRAFT)
  coverImage      String?

  images          ProjectImage[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model ProjectImage {
  id         String   @id @default(cuid())
  projectId  String

  url        String
  alt        String?
  sortOrder  Int      @default(0)

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
}

model Service {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  brief       String
  description String?
  image       String?
  active      Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id            String   @id @default(cuid())
  clientName    String
  clientRole    String?
  company       String?
  content       String
  rating        Int      @default(5)
  image         String?
  published     Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model HomepageContent {
  id        Int      @id @default(1)
  hero      Json
  stats     Json
  updatedAt DateTime @updatedAt
}

model ContactRequest {
  id         String        @id @default(cuid())
  name       String
  email      String
  phone      String?
  subject    String?
  message    String
  status     ContactStatus @default(NEW)
  notes      String?

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}
